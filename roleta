import React, { useState } from "react";
import { useNavigate } from "react-router-dom";

const CORES = ["#6366f1", "#10b981", "#0ea5e9", "#f59e0b", "#6366f1", "#10b981", "#0ea5e9", "#f59e0b"];

const FATIAS = CORES.map((cor, i) => {
  const a0 = ((i * 45 - 90) * Math.PI) / 180;
  const a1 = (((i + 1) * 45 - 90) * Math.PI) / 180;
  const x0 = 24 + 20 * Math.cos(a0);
  const y0 = 24 + 20 * Math.sin(a0);
  const x1 = 24 + 20 * Math.cos(a1);
  const y1 = 24 + 20 * Math.sin(a1);
  return { cor, d: `M24,24 L${x0.toFixed(2)},${y0.toFixed(2)} A20,20 0 0 1 ${x1.toFixed(2)},${y1.toFixed(2)} Z` };
});

export default function RoletaModulo({ modulos }) {
  const navigate = useNavigate();
  const [girando, setGirando] = useState(false);
  const vazio = !modulos || modulos.length === 0;

  const sortear = () => {
    if (vazio || girando) return;
    setGirando(true);
    setTimeout(() => {
      const escolhido = modulos[Math.floor(Math.random() * modulos.length)];
      setGirando(false);
      if (escolhido) navigate(`/modulo/${escolhido.id}`);
    }, 900);
  };

  return (
    <button
      type="button"
      onClick={sortear}
      disabled={vazio || girando}
      title="Sortear um módulo para a aula"
      aria-label="Sortear um módulo para a aula"
      className="w-10 h-10 rounded-xl border border-slate-700 bg-slate-900 flex items-center justify-center hover:border-indigo-400 hover:bg-slate-800 transition-colors disabled:opacity-40 disabled:cursor-not-allowed"
    >
      <svg viewBox="0 0 48 48" className={`w-6 h-6 ${girando ? "animate-spin" : ""}`}>
        {FATIAS.map((f, i) => (
          <path key={i} d={f.d} fill={f.cor} />
        ))}
        <circle cx="24" cy="24" r="20" fill="none" stroke="#020617" strokeWidth="1.5" />
        <circle cx="24" cy="24" r="5" fill="#020617" />
        <circle cx="24" cy="24" r="2" fill="#e2e8f0" />
      </svg>
    </button>
  );
}
