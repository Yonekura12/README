import React, { useState, useEffect } from "react";
import { useParams, useNavigate, Link } from "react-router-dom";
import { base44 } from "@/api/base44Client";
import { getTema } from "@/lib/disciplinaTema";
import {
  ArrowLeft,
  Loader2,
  Target,
  AlertCircle,
  Stethoscope,
  Search,
  BookText,
  Image as ImageIcon,
  Calculator,
  MousePointerClick,
  Globe,
  HelpCircle,
  ClipboardCheck,
  CheckCircle2,
  RefreshCw,
  Pencil,
  Trash2,
  ListChecks,
  Layers,
} from "lucide-react";
import SecaoModulo from "@/components/SecaoModulo";
import VisualizacaoSecao from "@/components/VisualizacaoSecao";
import MapaMental from "@/components/MapaMental";

export default function ModuloDetalhe() {
  const { id } = useParams();
  const navigate = useNavigate();
  const [modulo, setModulo] = useState(null);
  const [loading, setLoading] = useState(true);
  const [excluindo, setExcluindo] = useState(false);
  const [numQuestoes, setNumQuestoes] = useState(0);
  const [numFlashcards, setNumFlashcards] = useState(0);

  useEffect(() => {
    carregar();
  }, [id]);

  const carregar = async () => {
    try {
      const dados = await base44.entities.Modulo.get(id);
      setModulo(dados);
      const [qs, fs] = await Promise.all([
        base44.entities.Questao.filter({ modulo_id: id }),
        base44.entities.Flashcard.filter({ modulo_id: id }),
      ]);
      setNumQuestoes(qs ? qs.length : 0);
      setNumFlashcards(fs ? fs.length : 0);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  };

  const excluir = async () => {
    if (!confirm("Deseja excluir este módulo? Esta ação não pode ser desfeita.")) return;
    setExcluindo(true);
    try {
      await base44.entities.Modulo.delete(id);
      navigate("/");
    } catch (e) {
      console.error(e);
      setExcluindo(false);
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-slate-950">
        <Loader2 className="w-6 h-6 text-indigo-400 animate-spin" />
      </div>
    );
  }

  if (!modulo) {
    return (
      <div className="min-h-screen flex flex-col items-center justify-center bg-slate-950 px-4">
        <p className="text-slate-400 mb-4">Módulo não encontrado.</p>
        <Link to="/" className="text-indigo-400 font-medium">Voltar ao início</Link>
      </div>
    );
  }

  const tema = getTema(modulo.disciplina);

  return (
    <div className="min-h-screen bg-slate-950">
      {/* Header */}
      <header className="bg-slate-900/80 border-b border-slate-800 sticky top-0 z-10 backdrop-blur-md">
        <div className="max-w-3xl mx-auto px-4 sm:px-6 py-4">
          <Link to="/" className="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-slate-100 transition-colors mb-3">
            <ArrowLeft className="w-4 h-4" />
            Módulos
          </Link>
          <div className="flex items-start justify-between gap-4">
            <div className="min-w-0">
              <div className="flex flex-wrap items-center gap-2 mb-2">
                {modulo.disciplina && (
                  <span className={`px-2.5 py-0.5 rounded-full ${tema.badge} text-xs font-medium`}>
                    {modulo.disciplina}
                  </span>
                )}
                {modulo.nivel && (
                  <span className="px-2.5 py-0.5 rounded-full bg-slate-800 text-slate-400 text-xs font-medium">
                    {modulo.nivel}
                  </span>
                )}
                <span
                  className={`px-2.5 py-0.5 rounded-full text-xs font-medium ${
                    modulo.status === "Publicado"
                      ? "bg-emerald-500/15 text-emerald-300"
                      : "bg-amber-500/15 text-amber-300"
                  }`}
                >
                  {modulo.status || "Rascunho"}
                </span>
              </div>
              <h1 className="text-2xl sm:text-3xl font-bold text-slate-100 tracking-tight leading-tight">
                {modulo.titulo}
              </h1>
            </div>
            <div className="flex items-center gap-2 flex-shrink-0">
              <Link
                to={`/modulo/${id}/editar`}
                className="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-700 text-sm font-medium text-slate-200 hover:bg-slate-800 transition-colors"
              >
                <Pencil className="w-3.5 h-3.5" />
                Editar
              </Link>
              <button
                onClick={excluir}
                disabled={excluindo}
                className="inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-700 text-sm font-medium text-rose-400 hover:bg-rose-500/10 hover:border-rose-500/40 transition-colors disabled:opacity-50"
              >
                <Trash2 className="w-3.5 h-3.5" />
              </button>
            </div>
          </div>
        </div>
      </header>

      {/* Conteúdo */}
      <main className="max-w-3xl mx-auto px-4 sm:px-6 py-8 space-y-5">
        <MapaMental modulo={modulo} />

        {/* 1. Abertura */}
        <SecaoModulo numero={1} titulo="Abertura — Objetivo" icone={Target} destaque tema={tema}>
          {modulo.objetivo}
        </SecaoModulo>
        <SecaoModulo numero={1} titulo="Abertura — Contexto" icone={Target} destaque tema={tema}>
          {modulo.contexto}
        </SecaoModulo>

        {/* 2. Situação-problema */}
        <SecaoModulo numero={2} titulo="Situação-problema" icone={AlertCircle} tema={tema}>
          {modulo.situacao_problema}
        </SecaoModulo>

        {/* 3. Diagnóstico */}
        <SecaoModulo numero={3} titulo="Diagnóstico" icone={Stethoscope} tema={tema}>
          {modulo.diagnostico}
        </SecaoModulo>

        {/* 4. Investigação/hipótese */}
        <SecaoModulo numero={4} titulo="Investigação e hipóteses" icone={Search} tema={tema}>
          {modulo.investigacao}
        </SecaoModulo>

        {/* 5. Explicação conceitual */}
        <SecaoModulo numero={5} titulo="Explicação conceitual" icone={BookText} tema={tema}>
          {modulo.explicacao_conceitual}
        </SecaoModulo>

        {/* 6. Visualização */}
        <VisualizacaoSecao
          numero={6}
          url={modulo.visualizacao_url}
          descricao={modulo.visualizacao_descricao}
          tema={tema}
        />

        {/* 7. Matemática aplicada */}
        <SecaoModulo numero={7} titulo="Matemática aplicada" icone={Calculator} tema={tema}>
          {modulo.matematica_aplicada}
        </SecaoModulo>

        {/* 8. Interação ou simulação */}
        <SecaoModulo numero={8} titulo="Interação ou simulação" icone={MousePointerClick} tema={tema}>
          {modulo.interacao_simulacao}
        </SecaoModulo>

        {/* 9. Aplicação no cotidiano */}
        <SecaoModulo numero={9} titulo="Aplicação — Cotidiano, tecnologia, sociedade e ambiente" icone={Globe} tema={tema}>
          {modulo.aplicacao_cotidiano}
        </SecaoModulo>

        {/* 10. Questão ENEM */}
        <SecaoModulo numero={10} titulo="Questão estilo ENEM" icone={HelpCircle} tema={tema}>
          {modulo.questao_enem}
        </SecaoModulo>

        {/* 11. Atividade de consolidação */}
        <SecaoModulo numero={11} titulo="Atividade de consolidação" icone={ClipboardCheck} tema={tema}>
          {modulo.atividade_consolidacao}
        </SecaoModulo>

        {/* 12. Avaliação e feedback */}
        <SecaoModulo numero={12} titulo="Avaliação e feedback" icone={CheckCircle2} tema={tema}>
          {modulo.avaliacao_feedback}
        </SecaoModulo>

        {/* 13. Revisão/remediação */}
        <SecaoModulo numero={13} titulo="Revisão e remediação" icone={RefreshCw} tema={tema}>
          {modulo.revisao_remediacao}
        </SecaoModulo>

        {/* Recursos da aula */}
        <div className="grid grid-cols-1 sm:grid-cols-2 gap-5 pt-4">
          <div className="rounded-2xl border bg-slate-900 border-slate-800 p-6 flex flex-col">
            <ListChecks className={`w-6 h-6 ${tema.iconAccent} mb-3`} />
            <h3 className="font-semibold text-slate-100 mb-1">Quiz coletivo</h3>
            <p className="text-sm text-slate-400 mb-4 flex-1">
              {numQuestoes} {numQuestoes === 1 ? "questão cadastrada" : "questões cadastradas"} — a turma vota em cada
              alternativa e a mais votada é a escolha da classe.
            </p>
            <Link
              to={`/modulo/${id}/quiz`}
              className={`inline-flex justify-center px-4 py-2.5 rounded-xl ${tema.btn} text-sm font-medium transition-colors`}
            >
              {numQuestoes > 0 ? "Iniciar quiz" : "Ver quiz"}
            </Link>
            <Link to={`/modulo/${id}/questoes`} className="mt-2 text-center text-xs text-slate-500 hover:text-slate-300 transition-colors">
              gerenciar questões
            </Link>
          </div>
          <div className="rounded-2xl border bg-slate-900 border-slate-800 p-6 flex flex-col">
            <Layers className={`w-6 h-6 ${tema.iconAccent} mb-3`} />
            <h3 className="font-semibold text-slate-100 mb-1">Flashcards</h3>
            <p className="text-sm text-slate-400 mb-4 flex-1">
              {numFlashcards} {numFlashcards === 1 ? "card cadastrado" : "cards cadastrados"} — revisão rápida da turma
              no fim da aula, com frente e verso.
            </p>
            <Link
              to={`/modulo/${id}/flashcards`}
              className={`inline-flex justify-center px-4 py-2.5 rounded-xl ${tema.btn} text-sm font-medium transition-colors`}
            >
              Revisar cards
            </Link>
          </div>
        </div>
      </main>
    </div>
  );
}
